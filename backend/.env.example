# Copie para backend/.env e preencha (o .env não vai para o git)

# Neon: Dashboard > Connect > copie a connection string inteira e cole aqui, do jeito que vier
DATABASE_URL=postgresql://neondb_owner:sua-senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Senha usada na página /admin.html
ADMIN_PASSWORD=troque-essa-senha

# Origens permitidas (separadas por vírgula). Não é necessário quando o front usa o proxy da Vercel.
CORS_ORIGINS=http://localhost:5173

# Cloudflare R2 (opcional — sem isso, só links do YouTube funcionam)
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=motivacional
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
